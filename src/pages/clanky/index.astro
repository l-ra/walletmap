---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<ArticleLayout title="Články a novinky ARF" description="Týdenní přehledy ARF a publikace o evropské digitální identitě">
  <h1>Články a novinky ARF</h1>
  <p>Týdenní shrnutí vývoje Architecture and Reference Framework a další publikace o EU Digital Identity Wallet.</p>

  {articles.length === 0 ? (
    <p>Žádné články zatím nejsou publikované.</p>
  ) : (
    <ul class="article-list">
      {articles.map((article) => (
        <li>
          <a href={`/clanky/${article.slug}`}>
            {article.data.title}
            <time datetime={article.data.pubDate.toISOString()}>
              {article.data.pubDate.toLocaleDateString('cs-CZ', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}
</ArticleLayout>
