---
import { getCollection } from 'astro:content';

const latestArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 2);
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WalletMap.eu – Mapa evropské digitální identity</title>
  <meta name="description" content="WalletMap.eu mapuje využití EU Digital Identity Wallet na konkrétních modelových případech — od use case až po technickou specifikaci. Týdenní přehled vývoje ARF.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; color-scheme: dark; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #0b0d1a;
      color: #e8edf5;
      line-height: 1.6;
      overflow-x: hidden;
    }
    a { color: #9ec8ff; text-decoration: none; }
    a:hover { color: #cfe4ff; text-decoration: underline; }
    a:visited { color: #b8a8ff; }

    .bg-grid {
      position: fixed; inset: 0;
      background-image:
        radial-gradient(circle at 20% 50%, rgba(55, 125, 255, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 50%, rgba(0, 200, 255, 0.06) 0%, transparent 50%);
      z-index: -2;
    }
    .bg-grid::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(55, 125, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(55, 125, 255, 0.07) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 70%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 70%);
    }

    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.3;
      z-index: -1;
      animation: orbFloat 12s ease-in-out infinite alternate;
    }
    .orb--1 { width: 500px; height: 500px; background: #2b6aff; top: -10%; left: -8%; }
    .orb--2 { width: 400px; height: 400px; background: #00d4ff; bottom: -12%; right: -6%; animation-delay: -5s; }
    .orb--3 { width: 300px; height: 300px; background: #7c3aed; top: 50%; left: 50%; translate: -50% -50%; animation-delay: -9s; opacity: 0.15; }
    @keyframes orbFloat {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(30px, -40px) scale(1.1); }
    }

    .container { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

    header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 0;
    }
    .logo {
      font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em;
      display: flex; align-items: center; gap: 10px;
      color: #fff;
    }
    .logo svg { width: 32px; height: 32px; }
    .logo span { color: #5b8dff; }
    nav a {
      font-size: 0.9rem; font-weight: 500; color: #8892b0;
      transition: color 0.2s; margin-left: 32px;
    }
    nav a:hover { color: #fff; text-decoration: none; }

    .hero {
      display: flex; align-items: center; justify-content: center;
      text-align: center;
      padding: 48px 0 24px;
      position: relative;
    }
    .hero__inner { max-width: 820px; }
    .hero h1 {
      font-size: clamp(2.5rem, 7vw, 4.2rem);
      font-weight: 800; line-height: 1.1; letter-spacing: -0.03em;
      margin-bottom: 28px;
    }
    .hero h1 .highlight {
      background: linear-gradient(135deg, #4f8cff, #00d4ff);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero p {
      font-size: 1.15rem; color: #8892b0;
      max-width: 640px; margin: 0 auto 40px;
    }
    .hero__actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 34px; border-radius: 50px; font-weight: 600; font-size: 1rem;
      transition: all 0.25s; border: none; cursor: pointer;
    }
    .btn--primary {
      background: linear-gradient(135deg, #2b6aff, #00b8ff);
      color: #fff; box-shadow: 0 4px 24px rgba(43, 106, 255, 0.3);
    }
    .btn--primary:hover {
      transform: translateY(-2px); box-shadow: 0 8px 36px rgba(43, 106, 255, 0.45);
      text-decoration: none; color: #fff;
    }
    .btn--outline {
      background: transparent; color: #c8d0e0;
      border: 1px solid rgba(255,255,255,0.15);
    }
    .btn--outline:hover {
      border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.05);
      text-decoration: none; color: #fff;
    }

    section { padding: 100px 0; }
    .section-label {
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: #4f8cff; margin-bottom: 12px;
    }
    .section-title {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 700; letter-spacing: -0.02em;
      margin-bottom: 18px;
    }
    .section-sub {
      color: #8892b0; font-size: 1.05rem; max-width: 640px;
    }

    #approach { text-align: center; }
    #approach .section-sub { margin: 0 auto 60px; }

    .vertical-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      text-align: left;
    }
    .vertical-step {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px; padding: 24px 20px;
      position: relative;
    }
    .vertical-step__num {
      font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em;
      color: #4f8cff; margin-bottom: 10px;
    }
    .vertical-step h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; }
    .vertical-step p { font-size: 0.88rem; color: #8892b0; }

    #usecases { background: rgba(255,255,255,0.01); }
    #usecases .section-head {
      display: flex; flex-wrap: wrap; align-items: flex-end;
      justify-content: space-between; gap: 24px; margin-bottom: 48px;
    }
    #usecases .section-sub { margin: 0; }

    .usecase-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
    }
    .usecase-card {
      display: flex; flex-direction: column;
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px; padding: 36px 32px;
      transition: transform 0.3s, border-color 0.3s;
      color: inherit;
      text-decoration: none;
      min-height: 280px;
    }
    .usecase-card:hover {
      transform: translateY(-4px);
      border-color: rgba(79, 140, 255, 0.35);
      text-decoration: none;
      color: inherit;
    }
    .usecase-card:visited { color: inherit; }
    .usecase-card__domain {
      font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: #5de0ff; margin-bottom: 14px;
    }
    .usecase-card h3 {
      font-size: 1.45rem; font-weight: 700; margin-bottom: 12px; color: #fff;
    }
    .usecase-card p {
      font-size: 0.95rem; color: #8892b0; flex: 1; margin-bottom: 24px;
    }
    .usecase-card__meta {
      display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;
    }
    .usecase-card__chip {
      font-size: 0.72rem; font-weight: 600;
      padding: 4px 10px; border-radius: 6px;
      background: rgba(55, 125, 255, 0.12); color: #8cb4ff;
      border: 1px solid rgba(55, 125, 255, 0.2);
    }
    .usecase-card__cta {
      font-size: 0.9rem; font-weight: 600; color: #4f8cff;
    }
    .usecase-card:hover .usecase-card__cta { color: #8cb4ff; }

    #posledni-clanky { padding: 24px 0 72px; }
    #posledni-clanky .section-head {
      display: flex; flex-wrap: wrap; align-items: flex-end;
      justify-content: space-between; gap: 24px; margin-bottom: 28px;
    }
    #posledni-clanky .section-sub { margin: 0; }
    .latest-articles {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .latest-articles li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .latest-articles a {
      display: block;
      padding: 18px 4px;
      color: #e8edf5;
      font-weight: 700;
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      line-height: 1.35;
      letter-spacing: -0.02em;
    }
    .latest-articles a:hover {
      color: #8cb4ff;
      text-decoration: none;
    }
    .latest-articles a:visited { color: #e8edf5; }
    .latest-articles a:visited:hover { color: #8cb4ff; }
    .latest-articles-more {
      display: inline-block;
      margin-top: 20px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #4f8cff;
    }
    .latest-articles-more:hover { color: #8cb4ff; }

    #harmonogram { background: rgba(255,255,255,0.015); }
    #harmonogram .section-head {
      display: flex; flex-wrap: wrap; align-items: flex-end;
      justify-content: space-between; gap: 24px; margin-bottom: 36px;
    }
    #harmonogram .section-sub { margin: 0; }
    .timeline-card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px; padding: 28px 28px 24px;
    }
    .timeline-card__figure {
      margin: 0 0 20px; border-radius: 16px; overflow: hidden;
      border: 1px solid rgba(79, 140, 255, 0.25);
      background: rgba(18, 22, 42, 0.9);
    }
    .timeline-card__figure img {
      display: block; width: 100%; height: auto;
      min-height: 200px;
    }
    .timeline-card__caption {
      display: flex; flex-wrap: wrap; align-items: center;
      justify-content: space-between; gap: 16px;
    }
    .timeline-card__caption p {
      color: #8892b0; font-size: 0.92rem; max-width: 560px; margin: 0;
    }
    .timeline-card__caption .btn { padding: 12px 28px; font-size: 0.95rem; }

    footer {
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 30px 0; text-align: center; font-size: 0.85rem; color: #5a6480;
    }
    footer a { color: #9ec8ff; }
    footer a:hover { text-decoration: underline; }

    @media (max-width: 900px) {
      .vertical-steps { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      header { flex-wrap: wrap; row-gap: 12px; }
      nav { display: flex; flex-wrap: wrap; }
      nav a { margin-left: 0; margin-right: 16px; font-size: 0.8rem; }
      .hero { padding: 28px 0 8px; }
      .hero h1 { margin-bottom: 20px; }
      .hero p { margin-bottom: 28px; font-size: 1.05rem; }
      .hero__actions { flex-direction: column; align-items: center; }
      .vertical-steps { grid-template-columns: 1fr; }
      .usecase-grid { grid-template-columns: 1fr; }
      .latest-articles a { padding: 16px 0; }
      section { padding: 60px 0; }
      #posledni-clanky { padding: 8px 0 48px; }
    }
  </style>
</head>
<body>

  <div class="bg-grid"></div>
  <div class="orb orb--1"></div>
  <div class="orb orb--2"></div>
  <div class="orb orb--3"></div>

  <div class="container">
    <header>
      <div class="logo">
        <svg viewBox="0 0 32 32" fill="none"><rect x="2" y="6" width="28" height="20" rx="4" stroke="#4f8cff" stroke-width="2"/><rect x="8" y="11" width="6" height="5" rx="1.5" fill="#4f8cff"/><path d="M18 14l4 4m0 0l-4 4m4-4h-8" stroke="#5de0ff" stroke-width="2" stroke-linecap="round"/></svg>
        Wallet<span>Map</span>
      </div>
      <nav>
        <a href="#usecases">Modelové případy</a>
        <a href="#harmonogram">Harmonogram</a>
        <a href="#posledni-clanky">Články</a>
        <a href="/slovnik-zkratek">Slovník</a>
      </nav>
    </header>
  </div>

  <section class="hero">
    <div class="hero__inner container">
      <h1>
        Wallet<span style="color:#5b8dff;-webkit-text-fill-color:#5b8dff;">Map</span><br>
        <span class="highlight">od use case k technologii</span>
      </h1>
      <p>
        Mapujeme využití evropské peněženky digitální identity (EUDIW)
        na konkrétních modelových případech — kompletní vertikála od
        provozního scénáře přes role a průkazy až po protokoly, certifikáty a trust.
      </p>
      <div class="hero__actions">
        <a href="#usecases" class="btn btn--primary">
          Modelové případy
        </a>
        <a href="#posledni-clanky" class="btn btn--outline">
          Poslední články
        </a>
      </div>
    </div>
  </section>

  <section id="posledni-clanky">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-label">Publikace</div>
          <h2 class="section-title">Poslední přidané články</h2>
        </div>
      </div>
      {latestArticles.length === 0 ? (
        <p class="section-sub">Zatím tu nejsou žádné publikované články.</p>
      ) : (
        <ul class="latest-articles">
          {latestArticles.map((article) => (
            <li>
              <a href={`/clanky/${article.slug}`}>{article.data.title}</a>
            </li>
          ))}
        </ul>
      )}
      <a href="/clanky" class="latest-articles-more">Všechny články →</a>
    </div>
  </section>

  <section id="harmonogram">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-label">Legislativa</div>
          <h2 class="section-title">Harmonogram EUDIW</h2>
          <p class="section-sub">
            Klíčové termíny z nařízení eIDAS&nbsp;2.0 a prováděcích předpisů —
            od účinnosti technických specifikací po povinnost nabídnout peněženku
            a akceptovat ji u spoléhajících stran.
          </p>
        </div>
      </div>
      <div class="timeline-card">
        <figure class="timeline-card__figure">
          <img
            src="/images/eudiw-legislativni-harmonogram.svg"
            width="960"
            height="320"
            alt="Infografika harmonogramu EUDIW: 20. 5. 2024 účinnost nařízení, 24. 12. 2024 prováděcí předpisy peněženky, 27. 5. 2025 registrace RP, 24. 12. 2026 povinnost států nabídnout peněženku, 24. 12. 2027 povinná akceptace u regulovaných RP"
            loading="lazy"
          >
        </figure>
        <div class="timeline-card__caption">
          <p>
            Právní kotva běží od <strong style="color:#00d4ff;font-weight:600;">24.&nbsp;12.&nbsp;2024</strong>
            (účinnost IR k peněžence). Odtud se počítá 24&nbsp;měsíců pro státy
            a 36&nbsp;měsíců pro soukromé spoléhající strany ve regulovaných odvětvích.
          </p>
          <a href="/clanky/eudiw-legislativni-harmonogram" class="btn btn--primary">
            Celý přehled termínů
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="approach">
    <div class="container">
      <div class="section-label">Přístup</div>
      <h2 class="section-title">Kompletní vertikála každého případu</h2>
      <p class="section-sub">
        Každý modelový případ pokrývá všechny vrstvy: co se děje v provozu,
        kdo vystupuje v jaké roli, jaké průkazy a atributy se používají
        a jak to sedí na evropské specifikace.
      </p>
      <div class="vertical-steps">
        <div class="vertical-step">
          <div class="vertical-step__num">01</div>
          <h3>Use case</h3>
          <p>Konkrétní situace: členství, přístup, soutěž, správa průkazů.</p>
        </div>
        <div class="vertical-step">
          <div class="vertical-step__num">02</div>
          <h3>Role a procesy</h3>
          <p>Držitel, vydavatel, ověřovatel — user journey a provozní pravidla.</p>
        </div>
        <div class="vertical-step">
          <div class="vertical-step__num">03</div>
          <h3>Průkazy a data</h3>
          <p>Atestace, selektivní sdílení, status, revokace a intended use.</p>
        </div>
        <div class="vertical-step">
          <div class="vertical-step__num">04</div>
          <h3>Technologie</h3>
          <p>OID4VCI / OID4VP, WRPAC / WRPRC, proximity, trust listy a ARF.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="usecases">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-label">Modelové případy</div>
          <h2 class="section-title">Kde EUDIW dává smysl</h2>
          <p class="section-sub">
            Každý případ je samostatná vertikála — od provozního procesu
            po technickou implementaci v evropském rámci.
          </p>
        </div>
      </div>
      <div class="usecase-grid">
        <a class="usecase-card" href="/scenare/strelecky-klub">
          <div class="usecase-card__domain">Sport &amp; přístup</div>
          <h3>Střelecký klub</h3>
          <p>
            Členské průkazy, registrace závodníků se státními doklady,
            startovní lístky, elektronické zámky střelnice a ověřování
            rozhodčím — včetně registrace RP, vydávání a revokace.
          </p>
          <div class="usecase-card__meta">
            <span class="usecase-card__chip">OID4VCI</span>
            <span class="usecase-card__chip">OID4VP</span>
            <span class="usecase-card__chip">WRPRC</span>
            <span class="usecase-card__chip">Proximity</span>
            <span class="usecase-card__chip">PID</span>
          </div>
          <span class="usecase-card__cta">Prohlédnout scénáře →</span>
        </a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      &copy; 2026 <a href="https://walletmap.eu">WalletMap.eu</a> &mdash; Mapa evropské digitální identity.
      <br style="margin-top:4px;display:inline-block;">
      Modelové případy využití EU Digital Identity Wallet.
    </div>
  </footer>

  <script>
    const revealEls = document.querySelectorAll('.vertical-step, .usecase-card, .latest-articles');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
      observer.observe(el);
    });
  </script>
</body>
</html>
